# ============================================
# 7坛AI小编 环境变量配置文件
# 复制此文件为 .env 并填入真实值
# 勿提交 .env 到 Git！
# ============================================

# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 7坛网站登录
TANTAN_USERNAME=your-username
# TANTAN_PASSWORD 已改为加密存储，不再明文写入 .env
# 首次启动时通过 UI 输入密码，自动加密存入数据库
# TANTAN_PASSWORD=your-password

# 云存储配置 (阿里云 OSS)
OSS_PROVIDER=aliyun
OSS_ACCESS_KEY=your-access-key
OSS_SECRET_KEY=your-secret-key
OSS_BUCKET=7tan-games
OSS_REGION=oss-cn-shanghai
OSS_DOMAIN=https://games.7tan.cn
