    {
        "@context": "https://schema.org",
        "@type": "DiscussionForumPosting",
        "headline": <?php echo json_encode($topicTitle, JSON_UNESCAPED_UNICODE); ?>,
        "description": <?php echo json_encode($topicDesc, JSON_UNESCAPED_UNICODE); ?>,
        "text": <?php echo json_encode($topicText, JSON_UNESCAPED_UNICODE); ?>,
        <?php if ($topicImage): ?>
        "image": <?php echo json_encode($topicImage); ?>,
        <?php endif; ?>
        "author": {
            "@type": "Person",
            "name": <?php echo json_encode($topic['author_nick'] ?? '匿名', JSON_UNESCAPED_UNICODE); ?>
        },
