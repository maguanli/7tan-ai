                        <div class="post-content">
                            <?php echo safe_output(fast_ubb($topic['ll_text'])); ?>
                            <?php if (!empty($topic['ll_textb'])): ?>
                            <div class="post-extra">
                                <?php echo safe_output(fast_ubb($topic['ll_textb'])); ?>
                            </div>
                            <?php endif; ?>
                        </div>
                        
                        <?php 
                        // 解析附件列表
                        $attachments = [];
                        $furlField = !empty($topic['ll_url']) ? $topic['ll_url'] : $topic['ll_furl'];
                        if (!empty($furlField)) {
                            // 兼容旧格式: |描述|文件路径|大小|描述|文件路径|大小| (管道分隔的三元组)
                            if (strpos($furlField, '|') === 0) {
                                $parts = array_values(array_filter(explode('|', $furlField), function($v) { return $v !== ''; }));
                                $lines = [];
                                for ($i = 0; $i + 2 < count($parts); $i += 3) {
                                    $path = trim($parts[$i + 1]); // 中间是文件路径
                                    if (!empty($path) && strpos($path, '/') !== false) {
                                        $lines[] = $path;
                                    }
                                }
                            } elseif ($decoded = json_decode($furlField, true)) {
                                // 兼容 JSON 数组格式 (如 ["https://..."])
                                $lines = is_array($decoded) ? $decoded : [];
                            } else {
                                $lines = explode("\n", trim($furlField));
                            }
                            foreach ($lines as $line) {
                                $line = trim($line);
                                if (!empty($line)) {
                                    // 去掉可能重复的 /bbs/ 前缀
                                    $line = preg_replace('#^/bbs/#', '', $line);
                                    // 添加 /bbs/ 前缀（如果还没有）
                                    // 新上传路径 uploads/ 不需要加 /bbs/ 前缀（文件在 D:/workspace/7tan/uploads/）
                                    if (strpos($line, '/bbs/') !== 0 && strpos($line, 'http') !== 0 && strpos($line, 'uploads/') !== 0) {
                                        $line = '/bbs/' . $line;
                                    }
                                    $attachments[] = $line;
                                }
                            }
                        }
                        
                        if (!empty($attachments)): 
                            // 分类附件
                            $images = [];
                            $audios = [];
                            $videos = [];
                            $files = [];
                            
                            foreach ($attachments as $att) {
                                $ext = strtolower(pathinfo($att, PATHINFO_EXTENSION));
                                if (in_array($ext, ['jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp'])) {
                                    $images[] = $att;
                                } elseif (in_array($ext, ['mp3', 'wav', 'flac', 'aac', 'ogg', 'wma', 'm4a'])) {
                                    $audios[] = $att;
                                } elseif (in_array($ext, ['mp4', 'avi', 'mov', 'mkv', 'flv', 'wmv', 'webm', '3gp'])) {
                                    $videos[] = $att;
                                } else {
                                    $files[] = $att;
                                }
                            }
                        ?>
                        
                        <!-- 附件展示区域 -->
                        <div class="attachments-area">
                            <?php if (!empty($images)): ?>
                            <!-- 图片网格 -->
                            <div class="attachment-images">
                                <div class="attachment-title">
                                    <span class="att-icon">📷</span> 图片 (<span id="imageCount"><?php echo count($images); ?></span>)
                                </div>
                                <div class="image-grid" id="imageGrid">
                                    <?php foreach ($images as $idx => $img): ?>
                                    <div class="image-item" onclick="showImagePreview(<?php echo $idx; ?>)">
                                        <img src="<?php echo e($img); ?>" alt="<?php echo '图片' . ($idx + 1); ?>" loading="lazy" decoding="async" 
                                             onerror="this.parentNode.innerHTML='<div class=\'img-error\'><span>📷</span><small>加载失败</small></div>';">
                                    </div>
                                    <?php endforeach; ?>
                                </div>
                            </div>
                            <?php endif; ?>
                            
                            <?php if (!empty($audios)): ?>
                            <!-- 音频播放器 -->
                            <div class="attachment-audios">
                                <div class="attachment-title">
                                    <span class="att-icon">🎵</span> 音频 (<span id="audioCount"><?php echo count($audios); ?></span>)
                                </div>
                                <?php foreach ($audios as $idx => $audio): 
                                    $audioName = basename($audio);
                                ?>
                                <div class="audio-player">
                                    <div class="audio-info">
                                        <span class="audio-icon">🎵</span>
                                        <span class="audio-name"><?php echo e($audioName); ?></span>
                                    </div>
                                    <audio controlsList="download" controls>
