                                }
                                ?>
                                <?php if ($canApply): ?>
                                <a href="javascript:void(0);" class="btn btn-apply" id="btnApplyTask" onclick="applyCashTask(<?php echo $topicId; ?>, <?php echo $cashTask['id']; ?>)"><?php echo $applyText; ?></a>
