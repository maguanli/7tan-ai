                                            <span class="floor"><?php echo $floorNum; ?>楼</span>
                                            <?php if ($isPinned): ?>
                                            <span class="pinned-badge">置顶</span>
                                            <?php endif; ?>
                                            <?php if ($currentUser && $currentUserId != $replyUserId && !$isAiReply): ?>
                                            <a href="/bbs/message.php?to=<?php echo $replyUserId; ?>" class="msg-btn-sm" title="发私信">私信</a>
                                            <?php endif; ?>
                                        </div>
                                    </div>
                                    <?php if ($isTopicAuthor || $currentUser): ?>
                                    <div class="reply-actions">
                                        <?php if ($currentUser): ?>
                                        <a href="javascript:void(0);" class="reply-link" onclick="openReplyBox(<?php echo $floorNum; ?>, <?php echo $reply['id']; ?>)">回复</a>
                                        <?php else: ?>
                                        <a href="/bbs/login.php?redirect=<?php echo urlencode(bbsUrl('topic', $topicId) . '#reply-' . $reply['id']); ?>" class="reply-link" rel="nofollow">回复</a>
                                        <?php endif; ?>
                                        <?php if ($isTopicAuthor): ?>
                                        <a href="javascript:void(0);" class="pin-btn<?php echo $isPinned ? ' pinned' : ''; ?>" onclick="togglePin(<?php echo $reply['id']; ?>, <?php echo $isPinned ? '0' : '1'; ?>, this)" title="<?php echo $isPinned ? '取消置顶' : '置顶此回复'; ?>">
                                            <span class="pin-text"><?php echo $isPinned ? '❎'.'取消' : '📌'.'置顶'; ?></span>
