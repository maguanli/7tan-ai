                        </div>
                        <div id="repliesContainer">
                            <?php foreach ($replies as $index => $reply): ?>
                            <?php 
                            $isAiReply = (isset($reply['ll_ai']) && $reply['ll_ai'] == 1);
                            $isAi1 = ($reply['ll_useid'] == AI_USER_ID);
                            $isAi2 = ($reply['ll_useid'] == AI2_USER_ID);
                            $aiImg = $reply['ll_img'] ?: '/images/logo.png';
                            
                            // 计算楼层号
                            if ($sortOrder === 'ASC') {
                                $floorNum = $index + 2; // 正序：2, 3, 4...
                            } else {
                                $floorNum = $totalReplies - $index; // 倒序：最大, 最大-1...
                            }
                            
                            // 检查是否已点赞
                            $replyZaned = isset($replyZanedMap[$reply['id']]);
                            $replyZanCount = (int)($reply['ll_zan'] ?? 0);
                            
                            // 置顶状态 - 兼容两种方式: ll_ding=1 或 ll_time2='2100-10-10 12:12:12'
