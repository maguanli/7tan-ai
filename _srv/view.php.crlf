                    <?php
                    /* [AUTHOR-MORE 2026-10-30] 作者的其他文章：位于回复列表之后、回复框之前 */
                    $amList  = array();
                    $amUid   = (int)($topic['ll_useid'] ?? 0);
                    $amBoard = (int)($topic['ll_idd'] ?? 0);
                    if ($amUid > 0) {
                        try {
                            $amSql = "SELECT t.id, t.ll_biaoti, t.ll_idd, IFNULL(t.ll_rc, 0) AS views,
                                             DATE_FORMAT(t.ll_time1, '%Y-%m-%d') AS d,
                                             c.ll_title AS board_name
                                        FROM ll_lt t
                                        LEFT JOIN ll_class c ON t.ll_idd = c.id
                                       WHERE t.ll_useid = ? AND t.id <> ? AND IFNULL(t.ll_or, 0) = 0
                                       ORDER BY (t.ll_idd = " . $amBoard . ") DESC, t.id DESC
                                       LIMIT 6";
                            $amStmt = $pdo->prepare($amSql);
                            $amStmt->execute(array($amUid, (int)$topicId));
                            $amList = $amStmt->fetchAll(PDO::FETCH_ASSOC);
                        } catch (Exception $amEx) {
                            $amList = array();
                        }
                    }
                    if (count($amList) > 0):
                        $amName = trim((string)(($topic['author_nick'] ?? '') ?: ($topic['ll_name'] ?? '')));
                        if ($amName === '') { $amName = '楼主'; }
                    ?>
                    <style>
                    .author-more{margin:28px 0 6px;background:#fff;border:1px solid #e8eaf0;border-radius:12px}
                    .author-more .am-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border-bottom:1px solid #f0f1f5;background:linear-gradient(135deg,#f7f8ff 0%,#fdf7ff 100%);border-radius:12px 12px 0 0}
                    .author-more .am-title{margin:0;font-size:16px;font-weight:600;color:#2b2f3a;line-height:1.4}
                    .author-more .am-title em{font-style:normal;color:#667eea}
                    .author-more .am-profile{font-size:13px;color:#667eea;text-decoration:none;white-space:nowrap}
                    .author-more .am-profile:hover{text-decoration:underline}
                    .author-more .am-list{list-style:none;margin:0;padding:6px 10px 12px;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:2px}
                    .author-more .am-item{padding:8px 6px;border-radius:8px;transition:background .2s}
                    .author-more .am-item:hover{background:#f7f8ff}
                    .author-more .am-link{color:#2b2f3a;font-size:14px;line-height:1.55;text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
                    .author-more .am-link:hover{color:#667eea}
                    .author-more .am-meta{margin-top:5px;font-size:12px;color:#9aa0ae;display:flex;flex-wrap:wrap;align-items:center;gap:6px}
                    .author-more .am-board{color:#667eea;background:#eef0ff;border-radius:4px;padding:1px 6px}
                    .author-more .am-dot{color:#d0d3dc}
                    @media(max-width:640px){.author-more{margin:20px 0 4px}.author-more .am-list{grid-template-columns:1fr;padding:4px 8px 10px}}
                    </style>
                    <section class="author-more" aria-label="作者的其他文章">
                        <div class="am-head">
                            <h3 class="am-title"><em><?php echo e($amName); ?></em> 的其他文章</h3>
                            <a class="am-profile" href="/bbs/profile.php?id=<?php echo $amUid; ?>">作者主页</a>
                        </div>
                        <ul class="am-list">
                            <?php foreach ($amList as $am): ?>
                            <li class="am-item">
                                <a class="am-link" href="<?php echo e(bbsUrl('topic', $am['id'])); ?>"><?php echo e($am['ll_biaoti']); ?></a>
                                <div class="am-meta">
                                    <?php if (!empty($am['board_name'])): ?>
                                    <span class="am-board"><?php echo e($am['board_name']); ?></span>
                                    <span class="am-dot">·</span>
                                    <?php endif; ?>
                                    <span class="am-date"><?php echo e($am['d']); ?></span>
                                    <span class="am-dot">·</span>
