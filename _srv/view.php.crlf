    <script>
    // ==================== view.php 专用 JS ====================

    // ========== 浮动回复框功能 ==========
    let currentFloor = 0;
    let currentReplyToId = 0;

    function openReplyBox(floor, replyToId) {
        currentFloor = floor;
        currentReplyToId = replyToId;
        const targetLabel = replyToId > 0 ? '回复 ' + floor + '楼' : '回复楼主';
        document.getElementById('replyTarget').textContent = targetLabel;
        document.getElementById('floatReplyContent').value = '';
        document.getElementById('floatReplyBox').style.display = 'block';
        document.getElementById('floatReplyMask').style.display = 'block';
        document.getElementById('floatReplyContent').focus();
        document.body.style.overflow = 'hidden';
    }

    function closeReplyBox() {
        document.getElementById('floatReplyBox').style.display = 'none';
        document.getElementById('floatReplyMask').style.display = 'none';
        document.body.style.overflow = '';
        document.getElementById('floatAttachUrl').value = '';
        document.getElementById('floatImagePreview').innerHTML = '';
    }

    // ========== 图片上传处理（底部回复框） ==========
    async function handleImageUpload(input) {
        const file = input.files[0];
        if (!file) return;
        const preview = document.getElementById('imagePreview');
        preview.innerHTML = '<div class="upload-loading">上传中...</div>';
        const formData = new FormData();
        formData.append('file', file);
        try {
            const response = await fetch('<?php echo "/bbs/upload.php"; ?>', { method: 'POST', body: formData });
            const result = await response.json();
            if (result.code === 200) {
                document.getElementById('attachUrl').value = result.fileurl;
                preview.innerHTML = '<div class="preview-item"><img src="' + result.fileurl + '" alt="预览"><span class="remove-btn" onclick="removeImage()">×</span></div>';
            } else { alert(result.msg || '上传失败'); preview.innerHTML = ''; }
        } catch (error) { console.error('上传失败:', error); alert('上传失败，请重试'); preview.innerHTML = ''; }
        input.value = '';
    }

    function removeImage() {
        document.getElementById('attachUrl').value = '';
        document.getElementById('imagePreview').innerHTML = '';
    }

    // ========== 图片上传处理（浮动回复框） ==========
    async function handleFloatImageUpload(input) {
        const file = input.files[0];
        if (!file) return;
        const preview = document.getElementById('floatImagePreview');
        preview.innerHTML = '<div class="upload-loading-sm">...</div>';
        const formData = new FormData();
        formData.append('file', file);
        try {
            const response = await fetch('<?php echo "/bbs/upload.php"; ?>', { method: 'POST', body: formData });
            const result = await response.json();
            if (result.code === 200) {
                document.getElementById('floatAttachUrl').value = result.fileurl;
                preview.innerHTML = '<div class="preview-item-sm"><img src="' + result.fileurl + '" alt="预览"><span class="remove-btn-sm" onclick="removeFloatImage()">×</span></div>';
            } else { alert(result.msg || '上传失败'); preview.innerHTML = ''; }
        } catch (error) { console.error('上传失败:', error); preview.innerHTML = ''; }
        input.value = '';
    }

    function removeFloatImage() {
        document.getElementById('floatAttachUrl').value = '';
        document.getElementById('floatImagePreview').innerHTML = '';
    }

    // ========== 表情相关函数 ==========
    function insertEmoji(emoji, textareaId) {
        const textarea = document.getElementById(textareaId);
        if (!textarea) return;
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;
        textarea.value = text.substring(0, start) + emoji + text.substring(end);
        textarea.selectionStart = textarea.selectionEnd = start + emoji.length;
        textarea.focus();
        $('.modal-tooltip').fadeOut();
    }

    $(function(){
        $(document).on("click", ".comment-icon", function(event){ $(this).find('.modal-tooltip').fadeIn(); event.stopPropagation(); });
        $(document).on("click", ".modal-tooltip span", function(event){
            event.stopPropagation(); event.preventDefault();
            var emoji = $(this).data('emoji'); if (!emoji) return;
            var replyBox = $(this).closest('.float-reply-box, .reply-box');
            if (replyBox.length) { var textarea = replyBox.find('textarea'); if (textarea.length) { insertEmoji(emoji, textarea.attr('id')); return; } }
            insertEmoji(emoji, 'replyContent');
        });
        $('body').on("click", function(event){ if (!$(event.target).closest('.modal-tooltip, .comment-icon').length) { $('.modal-tooltip').fadeOut(); } });
    });

    // ========== 提交回复 ==========
    async function submitReply() {
        const content = document.getElementById('floatReplyContent').value.trim();
        if (!content) { alert('请输入回复内容'); return; }
        const formData = new FormData();
        formData.append('topic_id', topicId);
        formData.append('content', content);
        formData.append('floor', currentFloor);
        formData.append('parent_id', currentReplyToId);
        const attachUrl = document.getElementById('floatAttachUrl').value;
        if (attachUrl) { formData.append('attach_url', attachUrl); }
        try {
            const response = await fetch('<?php echo "/bbs/reply.php"; ?>', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: formData });
            const result = await response.json();
            if (result.code === 200) { closeReplyBox(); window.location.reload(); }
            else { alert(result.msg || '提交失败'); }
        } catch (error) { console.error('提交失败:', error); alert('提交失败，请重试'); }
    }

    // ========== 排序切换 ==========
    function changeSort(sort) { if (sort === currentSort) return; window.location.href = '<?php echo "/bbs/"; ?>' + topicId + '/?sort=' + sort; }

    // ========== 加载更多回复 ==========
    async function loadMoreReplies() {
        if (isLoading) return;
        if (currentPage >= totalPages) { document.getElementById('loadMoreStatus').innerHTML = '<div class="no-more">— 已加载全部回复 —</div>'; return; }
        isLoading = true;
        const statusDiv = document.getElementById('loadMoreStatus');
        statusDiv.innerHTML = '<div class="loading-more"><span class="spinner"></span>加载中...</div>';
        try {
            const formData = new FormData();
            formData.append('topic_id', topicId); formData.append('page', currentPage + 1); formData.append('sort', currentSort);
            const response = await fetch('<?php echo "/bbs/load_replies.php"; ?>', { method: 'POST', body: formData });
            if (!response.ok) throw new Error('HTTP ' + response.status);
            const result = await response.json();
            if (result.code === 200 && result.data && result.data.length > 0) {
                const container = document.getElementById('repliesContainer');
                result.data.forEach(reply => {
                    const aiClass = reply.is_ai ? ' ai-post' : '';
                    const isChild = reply.type === 'child';
                    const floorClass = isChild ? ' sub-floor' : '';
                    const subRepliesClass = isChild ? ' sub-reply' : '';
                    const zanClass = reply.zaned ? ' zaned' : '';
                    const zanIcon = reply.zaned ? '💚' : '🤍';
                    let html = '<div class="post reply-post' + aiClass + subRepliesClass + '" id="reply-' + reply.id + '"><div class="post-header"><div class="post-author">' +
                        (reply.avatar ? '<img src="' + reply.avatar + '" alt="" class="avatar' + (isChild ? ' avatar-sm' : '') + '" onerror="this.style.display=\'none\'; this.nextElementSibling.style.display=\'flex\';">' : '') +
                        '<div class="avatar-fallback" style="' + (reply.avatar ? 'display:none;' : 'display:flex;') + ' width:' + (isChild ? '32px' : '40px') + '; height:' + (isChild ? '32px' : '40px') + '; border-radius:50%; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); align-items:center; justify-content:center; color:#fff; font-size:' + (isChild ? '14px' : '16px') + '; font-weight:bold; flex-shrink:0;">' + reply.username.charAt(0) + '</div>' +
                        '<div class="author-info"><span class="username">' + reply.username + '</span><span class="floor' + floorClass + '">' + reply.floor_display + '</span></div></div>' +
                        (reply.can_reply ? '<a href="javascript:void(0);" class="reply-link" onclick="openReplyBox(' + reply.floor_num + ', ' + reply.id + ')">回复</a>' : '') +
                        '</div><div class="post-content">' + reply.content + (reply.image ? '<div class="reply-images"><img src="' + reply.image + '" alt="附件图片" class="reply-image" onclick="showImage(this.src)"></div>' : '') + '</div><div class="post-footer"><span class="time">' + reply.time + '</span>' +
                        '<a href="javascript:void(0);" class="action-btn reply-zan-btn' + zanClass + '" onclick="toggleZan(\'reply\', ' + reply.id + ', this)"><span class="zan-icon">' + zanIcon + '</span><span class="zan-count">' + reply.zan_count + '</span></a></div></div>';
                    container.insertAdjacentHTML('beforeend', html);
                });
                currentPage++;
                if (currentPage >= totalPages) { document.getElementById('loadMoreStatus').innerHTML = '<div class="no-more">— 已加载全部回复 —</div>'; }
                else { document.getElementById('loadMoreStatus').innerHTML = ''; }
            } else { document.getElementById('loadMoreStatus').innerHTML = '<div class="no-more">— 已加载全部回复 —</div>'; currentPage = totalPages; }
        } catch (error) { console.error('加载失败:', error); statusDiv.innerHTML = '<div class="loading-more" style="color:#e74c3c;">加载失败，请滚动重试</div>'; }
        isLoading = false;
    }

    function checkAndLoadMore() {
        if (currentPage >= totalPages) { document.getElementById('loadMoreStatus').innerHTML = '<div class="no-more">— 已加载全部回复 —</div>'; return; }
        const scrollHeight = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight);
        const scrollTop = Math.max(document.documentElement.scrollTop, document.body.scrollTop);
        const clientHeight = document.documentElement.clientHeight;
        if (scrollTop + clientHeight >= scrollHeight - 200) { if (!isLoading) loadMoreReplies(); }
    }
    let scrollTimer = null;
    window.addEventListener('scroll', function() { if (scrollTimer) clearTimeout(scrollTimer); scrollTimer = setTimeout(checkAndLoadMore, 100); });

    // ========== 展开/折叠子回复 ==========
    function toggleReplies(replyId) {
        const repliesDiv = document.getElementById('sub-replies-' + replyId);
        const toggleBtn = repliesDiv ? repliesDiv.previousElementSibling.querySelector('.toggle-replies-btn') : null;
        if (!repliesDiv) return;
        const isHidden = repliesDiv.style.display === 'none' || repliesDiv.style.display === '';
        if (isHidden) { repliesDiv.style.display = 'block'; if (toggleBtn) toggleBtn.innerHTML = '<span class="toggle-icon">▲</span> 收起回复'; }
        else { repliesDiv.style.display = 'none'; if (toggleBtn) toggleBtn.innerHTML = '<span class="toggle-icon">▼</span> 查看' + repliesDiv.children.length + '条回复'; }
    }

    // ========== 点赞功能 ==========
    async function toggleZan(type, id, btnElement) {
        try {
            const formData = new FormData();
            formData.append('type', type); formData.append('id', id);
            const response = await fetch('<?php echo "/bbs/zan.php"; ?>', { method: 'POST', body: formData });
            const result = await response.json();
            if (result.code === 200) {
                if (type === 'topic') {
                    const zanBtn = document.getElementById('topicZanBtn');
                    const zanIcon = document.getElementById('topicZanIcon');
                    const zanCount = document.getElementById('topicZanCount');
                    if (result.zaned) { zanBtn.classList.add('zaned'); zanIcon.textContent = '💚'; } else { zanBtn.classList.remove('zaned'); zanIcon.textContent = '🤍'; }
                    zanCount.textContent = result.zan_count;
                } else if (btnElement) {
                    const zanIcon = btnElement.querySelector('.zan-icon');
                    const zanCount = btnElement.querySelector('.zan-count');
                    if (result.zaned) { btnElement.classList.add('zaned'); zanIcon.textContent = '💚'; } else { btnElement.classList.remove('zaned'); zanIcon.textContent = '🤍'; }
                    zanCount.textContent = result.zan_count;
                }
            } else if (result.code === 401) { alert('请先登录'); window.location.href = 'login.php?redirect=' + encodeURIComponent(window.location.pathname + '?id=' + topicId); }
            else { alert(result.msg || '操作失败'); }
        } catch (error) { console.error('点赞失败:', error); alert('操作失败，请重试'); }
    }

    // ========== 现金任务接单 ==========
    async function applyCashTask(bbsPostId, taskId) {
        const btn = document.getElementById('btnApplyTask');
        if (!btn) return;
        btn.textContent = '处理中...';
        btn.style.pointerEvents = 'none';
        try {
            const formData = new FormData();
            formData.append('bbs_post_id', bbsPostId);
            formData.append('task_id', taskId);
            const response = await fetch('<?php echo "/bbs/task_apply.php"; ?>', {
                method: 'POST',
                body: formData,
                credentials: 'include'
            });
            // 检查 HTTP 状态
            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }
            // 检查 Content-Type 是否为 JSON
            const contentType = response.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
                const text = await response.text();
                throw new Error('非JSON响应: ' + text.substring(0, 200));
            }
            const result = await response.json();
            if (result.code === 0) {
                btn.textContent = '已申请 ✓';
                btn.classList.add('applied');
                btn.style.pointerEvents = 'none';
                alert('接单成功！请等待金主确认。');
            } else if (result.code === 401) {
                alert('请先登录');
                window.location.href = '<?php echo "/bbs/login.php"; ?>?redirect=' + encodeURIComponent(window.location.pathname + '?id=' + topicId);
            } else if (result.code === 424) {
                if (confirm('参与现金任务需先完成实名认证，是否现在前往认证？')) {
                    window.location.href = '<?php echo "/bbs/user.php"; ?>?tab=verify';
                }
                btn.textContent = '💰 接单';
                btn.style.pointerEvents = 'auto';
            } else {
                alert(result.msg || '接单失败，请稍后重试');
                btn.textContent = '💰 接单';
                btn.style.pointerEvents = 'auto';
            }
        } catch (error) {
            console.error('接单失败:', error);
            alert('接单失败: ' + (error.message || '请稍后重试'));
            btn.textContent = '💰 接单';
            btn.style.pointerEvents = 'auto';
        }
    }

    // ========== 置顶回复功能 ==========
    async function togglePin(replyId, action, btnElement) {
        try {
            const formData = new FormData();
            formData.append('reply_id', replyId); formData.append('action', action);
            const response = await fetch('<?php echo "/bbs/pin.php"; ?>', { method: 'POST', body: formData, credentials: 'include' });
            if (!response.ok) throw new Error('HTTP错误: ' + response.status);
            const result = await response.json();
            if (result.code === 200) {
                const replyPost = document.getElementById('reply-' + replyId);
                if (result.ding == 1) {
                    if (replyPost) replyPost.classList.add('pinned');
                    if (btnElement) { btnElement.classList.add('pinned'); const pinText = btnElement.querySelector('.pin-text'); if (pinText) pinText.textContent = '❎取消'; btnElement.title = '点击取消置顶'; btnElement.setAttribute('onclick', 'togglePin(' + replyId + ', 0, this)'); }
                    const floorSpan = document.querySelector('#reply-' + replyId + ' .floor');
                    if (floorSpan && !floorSpan.nextElementSibling?.classList.contains('pinned-badge')) { const badge = document.createElement('span'); badge.className = 'pinned-badge'; badge.textContent = '置顶'; floorSpan.insertAdjacentElement('afterend', badge); }
                } else {
                    if (replyPost) replyPost.classList.remove('pinned');
                    if (btnElement) { btnElement.classList.remove('pinned'); const pinText = btnElement.querySelector('.pin-text'); if (pinText) pinText.textContent = '📌置顶'; btnElement.title = '点击置顶'; btnElement.setAttribute('onclick', 'togglePin(' + replyId + ', 1, this)'); }
                    const badge = document.querySelector('#reply-' + replyId + ' .pinned-badge'); if (badge) badge.remove();
                }
            } else if (result.code === 403) { alert(result.msg || '只有楼主才能置顶回复'); }
            else if (result.code === 401) { alert('请先登录'); window.location.href = 'login.php?redirect=' + encodeURIComponent(window.location.pathname + '?id=' + topicId); }
            else { alert(result.msg || '操作失败，请刷新重试'); }
        } catch (error) { console.error('置顶失败:', error); alert('操作失败: ' + error.message); }
    }

    // ========== 版主操作 ==========
    async function toggleTopicAction(topicId, action) {
        try {
            const formData = new FormData();
            formData.append('topic_id', topicId); formData.append('action', action);
            const response = await fetch('<?php echo "/bbs/topic_action_debug.php"; ?>', { method: 'POST', body: formData, credentials: 'include' });
            if (!response.ok) throw new Error('HTTP错误: ' + response.status);
            const result = await response.json();
            if (result.code === 200) {
                const isActive = result.value == 1;
                if (action === 'jing') { const btn = document.querySelector('.mod-jing'); if (btn) { btn.classList.toggle('active', isActive); btn.innerHTML = isActive ? '❎取消精华' : '⭐加精'; } }
                else if (action === 'ding') { const btn = document.querySelector('.mod-ding'); if (btn) { btn.classList.toggle('active', result.value == 1); btn.innerHTML = result.value == 1 ? '❎取消置顶' : '📌置顶'; } updateTopicTag('ding', result.value == 1); }
                else if (action === 'lock') { const btn = document.querySelector('.mod-lock'); if (btn) { btn.classList.toggle('active', result.value == 1); btn.innerHTML = result.value == 1 ? '🔓解锁' : '🔒锁定'; } updateTopicTag('lock', result.value == 1); const replyBtns = document.querySelectorAll('.btn-reply'); replyBtns.forEach(b => b.style.display = result.value == 1 ? 'none' : ''); if (result.value == 1) showLockTip(); else hideLockTip(); }
                else if (action === 'hide') { const btn = document.querySelector('.mod-hide'); if (btn) { btn.classList.toggle('active', result.value == 1); btn.innerHTML = result.value == 1 ? '👁️显示' : '🚫隐藏'; } updateTopicTag('hide', result.value == 1); updateHiddenNotice(result.value == 1); }
            } else if (result.code === 403) { alert(result.msg || '无权限'); }
            else if (result.code === 401) { alert('请先登录'); }
            else { alert(result.msg || '操作失败'); }
        } catch (error) { console.error('版主操作失败:', error); alert('操作失败: ' + error.message); }
    }

    function updateTopicTag(tag, show) {
        const topicHeader = document.querySelector('.topic-header h1'); if (!topicHeader) return;
        const tagMap = { ding: ['tag-top', '置顶'], jing: ['tag-jing', '精华'], lock: ['tag-lock', '锁定'], hide: ['tag-hide', '已隐藏'] };
        const info = tagMap[tag]; if (!info) return;
        let tagEl = topicHeader.querySelector('.' + info[0]);
        if (show && !tagEl) { const span = document.createElement('span'); span.className = 'tag ' + info[0]; span.textContent = info[1]; topicHeader.insertBefore(span, topicHeader.firstChild); }
        else if (!show && tagEl) { tagEl.remove(); }
    }

    function showLockTip() {
        const repliesSection = document.querySelector('.replies-section');
        if (repliesSection && !document.querySelector('.lock-tip')) { const tip = document.createElement('div'); tip.className = 'lock-tip'; tip.style.cssText = 'background:#f8d7da;color:#721c24;padding:15px 20px;border-radius:8px;margin-bottom:20px;text-align:center;'; tip.innerHTML = '🔒 本帖已被锁定，禁止回复'; repliesSection.insertBefore(tip, repliesSection.firstChild); }
    }
    function hideLockTip() { const tip = document.querySelector('.lock-tip'); if (tip) tip.remove(); }
    function updateHiddenNotice(isHidden) {
        const topicView = document.querySelector('.topic-view'); if (!topicView) return;
        const existingNotice = document.querySelector('.hidden-topic-notice'); if (existingNotice) existingNotice.remove();
        if (isHidden) { const notice = document.createElement('div'); notice.className = 'hidden-topic-notice'; notice.innerHTML = '<strong>🚫 此帖已被版主隐藏</strong><br>内容包含违规信息已被屏蔽'; topicView.insertBefore(notice, topicView.firstChild); const mainPost = document.querySelector('.main-post'); if (mainPost) { const contentDiv = mainPost.querySelector('.post-content'); if (contentDiv) { contentDiv.style.filter = 'blur(8px)'; contentDiv.style.userSelect = 'none'; contentDiv.style.pointerEvents = 'none'; } } }
        else { const mainPost = document.querySelector('.main-post'); if (mainPost) { const contentDiv = mainPost.querySelector('.post-content'); if (contentDiv) { contentDiv.style.filter = ''; contentDiv.style.userSelect = ''; contentDiv.style.pointerEvents = ''; } } }
    }

    // ========== 分享弹窗 ==========
    function showShareModal() { document.getElementById('shareModal').classList.add('show'); }
    function hideShareModal() { document.getElementById('shareModal').classList.remove('show'); }
    function getShareUrl() { return window.location.href; }
    function shareToWeixin() { if (navigator.clipboard) { navigator.clipboard.writeText(getShareUrl()).then(() => { alert('链接已复制，可粘贴到微信分享'); }); } else { copyLink(); } hideShareModal(); }
    function copyLink() { if (navigator.clipboard) { navigator.clipboard.writeText(getShareUrl()).then(() => { alert('链接已复制到剪贴板'); }).catch(() => { prompt('请复制以下链接:', getShareUrl()); }); } else { prompt('请复制以下链接:', getShareUrl()); } hideShareModal(); }

    // ========== 分享游戏功能 ==========
    let shareSearchType = 'game';
    let currentReplyBox = 'main';
    function openShareGameModal(replyBox) { currentReplyBox = replyBox || 'main'; document.getElementById('shareGameModal').style.display = 'block'; document.getElementById('shareGameMask').style.display = 'block'; document.getElementById('shareSearchInput').value = ''; document.getElementById('shareGameResults').innerHTML = '<div class="search-tip">输入关键词搜索游戏或帖子</div>'; document.getElementById('shareSearchInput').focus(); }
    function closeShareGameModal() { document.getElementById('shareGameModal').style.display = 'none'; document.getElementById('shareGameMask').style.display = 'none'; }
    function switchShareTab(type) { shareSearchType = type; document.querySelectorAll('.share-game-tabs .tab-btn').forEach(btn => { btn.classList.toggle('active', btn.dataset.type === type); }); const keyword = document.getElementById('shareSearchInput').value.trim(); if (keyword) doShareSearch(); }
    function handleShareSearch(event) { if (event.key === 'Enter') doShareSearch(); }
    async function doShareSearch() {
        const keyword = document.getElementById('shareSearchInput').value.trim(); if (!keyword) { alert('请输入搜索关键词'); return; }
        const resultsDiv = document.getElementById('shareGameResults'); resultsDiv.innerHTML = '<div class="search-tip">🔍 搜索中...</div>';
        try {
            const response = await fetch('<?php echo "/bbs/share_search.php"; ?>?ac=' + shareSearchType + '&keyword=' + encodeURIComponent(keyword), { credentials: 'include' });
            const result = await response.json();
            if (result.code === 401) { resultsDiv.innerHTML = '<div class="search-tip">请先登录后再使用分享功能</div>'; return; }
            if (result.code === 200 && result.data.length > 0) {
                let html = '';
                result.data.forEach(item => {
                    const shareText = item.share_text.replace(/<br\s*\/?>/gi, '\n');
                    if (item.type === 'game') { html += '<div class="share-item" onclick="insertShareGame(this.dataset.text)" data-text="' + encodeURIComponent(shareText) + '"><img src="' + (item.logo || '/images/default-game.png') + '" alt="" class="share-item-img" onerror="this.src=\'/images/default-game.png\'"><div class="share-item-info"><div class="share-item-title">🎮 ' + escapeHtml(item.title) + '</div><div class="share-item-desc">' + escapeHtml(item.category) + '</div></div></div>'; }
                    else { html += '<div class="share-item" onclick="insertShareGame(this.dataset.text)" data-text="' + encodeURIComponent(shareText) + '"><div class="share-item-icon">📝</div><div class="share-item-info"><div class="share-item-title">📝 ' + escapeHtml(item.title) + '</div><div class="share-item-desc">来自 ' + escapeHtml(item.category) + ' · 回复 ' + item.reply_count + '</div></div></div>'; }
                });
                resultsDiv.innerHTML = html;
            } else { resultsDiv.innerHTML = '<div class="search-tip">没有找到相关结果</div>'; }
        } catch (error) { console.error('搜索失败:', error); resultsDiv.innerHTML = '<div class="search-tip">搜索失败，请确保已登录后重试</div>'; }
    }
    function escapeHtml(str) { const div = document.createElement('div'); div.textContent = str; return div.innerHTML.replace(/'/g, "\\'"); }
    function insertShareGame(encodedText) {
        const shareText = decodeURIComponent(encodedText);
        if (currentReplyBox === 'float') { const textarea = document.getElementById('floatReplyContent'); textarea.value = (textarea.value ? textarea.value + '\n\n' : '') + shareText; }
        else { const textarea = document.getElementById('replyContent'); textarea.value = (textarea.value ? textarea.value + '\n\n' : '') + shareText; }
        closeShareGameModal();
    }

    // ========== AI辅助回复 ==========
    async function getAISuggestion() {
        const btn = document.getElementById('aiHintBtn'); const suggestionsDiv = document.getElementById('aiSuggestions'); const suggestionList = document.getElementById('suggestionList');
        btn.classList.add('loading'); btn.innerHTML = '<span>⏳</span> AI生成中...';
        try {
            const formData = new FormData(); formData.append('title', topicTitle); formData.append('content', topicContent);
            const response = await fetch('<?php echo "/bbs/ai_suggest.php"; ?>', { method: 'POST', body: formData });
            const result = await response.json();
            if (result.code === 200 && result.data) {
                const suggestions = result.data.split('\n').filter(s => s.trim()); suggestionList.innerHTML = '';
                if (suggestions.length > 0) { suggestions.forEach(suggestion => { const div = document.createElement('div'); div.className = 'ai-suggestion-item'; div.textContent = suggestion; div.onclick = function() { document.getElementById('replyContent').value = suggestion; suggestionsDiv.classList.remove('show'); }; suggestionList.appendChild(div); }); suggestionsDiv.classList.add('show'); }
                else { alert('暂无建议，可以直接回复哦~'); }
            } else { alert(result.msg || '获取建议失败'); }
        } catch (error) { console.error('AI建议错误:', error); alert('获取AI建议失败，请稍后重试'); }
        btn.classList.remove('loading'); btn.innerHTML = '<span>💡</span> AI建议';
    }

    // ========== 附件预览功能 ==========
    function showImagePreview(index) { if (allImages.length === 0) return; currentImageIndex = index; updatePreviewImage(); document.getElementById('imagePreviewModal').classList.add('show'); document.body.style.overflow = 'hidden'; }
    function closeImagePreview() { document.getElementById('imagePreviewModal').classList.remove('show'); document.body.style.overflow = ''; }
    function showImage(src) { const modal = document.getElementById('imagePreviewModal'); const img = modal.querySelector('.preview-image'); if (img) { img.src = src; modal.classList.add('show'); document.body.style.overflow = 'hidden'; } }
    function updatePreviewImage() { document.getElementById('previewImage').src = allImages[currentImageIndex]; document.getElementById('previewCounter').textContent = (currentImageIndex + 1) + ' / ' + allImages.length; }
    function prevImage() { currentImageIndex = (currentImageIndex - 1 + allImages.length) % allImages.length; updatePreviewImage(); }
    function nextImage() { currentImageIndex = (currentImageIndex + 1) % allImages.length; updatePreviewImage(); }
    document.addEventListener('keydown', function(e) { if (!document.getElementById('imagePreviewModal').classList.contains('show')) return; if (e.key === 'Escape') closeImagePreview(); if (e.key === 'ArrowLeft') prevImage(); if (e.key === 'ArrowRight') nextImage(); });

    // ========== 页面初始化 ==========
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.post-content img, .reply-content img').forEach(function(img) {
            if (img.parentElement && img.parentElement.getAttribute('data-emoji')) return;
            if (img.width <= 30 && img.height <= 30) return;
            img.style.maxWidth = '100%'; img.style.maxHeight = '400px'; img.style.objectFit = 'contain'; img.style.borderRadius = '8px'; img.style.cursor = 'pointer';
            img.onerror = function() { this.style.display = 'none'; var placeholder = document.createElement('div'); placeholder.style.cssText = 'width:100%; height:60px; background:linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%); border-radius:8px; display:flex; align-items:center; justify-content:center; color:#999; font-size:12px; margin:10px 0;'; placeholder.innerHTML = '<span>📷 图片加载失败</span>'; this.parentNode.insertBefore(placeholder, this); };
        });
        document.getElementById('imagePreviewModal').addEventListener('click', function(e) { if (e.target === this) closeImagePreview(); });
        document.getElementById('shareGameModal').addEventListener('click', function(e) { if (e.target === this) closeShareGameModal(); });
        document.getElementById('shareModal').addEventListener('click', function(e) { if (e.target === this) hideShareModal(); });
    });

    </script>
    <script>
    // PHP变量初始化
    const topicId = <?php echo $topicId; ?>;
    const totalReplies = <?php echo $totalReplies; ?>;
    const totalPages = <?php echo $totalPages; ?>;
    const pageSize = <?php echo $pageSize; ?>;
    const isLocked = <?php echo !empty($topic['ll_lock']) ? 'true' : 'false'; ?>;
    const isHidden = <?php echo !empty($topic['ll_hide']) ? 'true' : 'false'; ?>;
    let currentPage = 1;
    let currentSort = '<?php echo strtolower($sortOrder); ?>';
    let isLoading = false;
    const topicTitle = <?php echo json_encode(toHalfWidth($topic['ll_biaoti'])); ?>;
    const topicContent = <?php echo json_encode(strip_tags($topic['ll_text'])); ?>;
    const allImages = <?php echo json_encode($images ?? []); ?>;
    let currentImageIndex = 0;

    // 初始状态检查
    if (isLocked) showLockTip();
    if (isHidden) updateHiddenNotice(true);

    // shareToWeibo 需要 PHP 变量
    function shareToWeibo() {
        const title = <?php echo json_encode(toHalfWidth($topic['ll_biaoti'])); ?>;
        const url = getShareUrl();
        const weiboUrl = 'http://service.weibo.com/share/share.php?title=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(url);
        window.open(weiboUrl, '_blank');
        hideShareModal();
    }

    // shareToQQ 需要 PHP 变量
    function shareToQQ() {
        const title = <?php echo json_encode(toHalfWidth($topic['ll_biaoti'])); ?>;
        const url = getShareUrl();
        const qqUrl = 'http://connect.qq.com/widget/shareqq/index.html?url=' + encodeURIComponent(url) + '&title=' + encodeURIComponent(title);
        window.open(qqUrl, '_blank');
        hideShareModal();
    }
    </script>

    
    <!-- 返回顶部 -->
    <button class="back-to-top" id="backToTop" title="返回顶部">↑</button>
    <script src="<?php echo $baseUrl; ?>js/common.js"></script>
<?php $mobileNavActive = 'list'; include __DIR__ . '/mobile_nav.php'; ?>
</body>
</html>

<?php
// ==================== 写入页面缓存（仅未登录用户） ====================
if ($currentUserId <= 0) {
    $html = ob_get_contents();
    if (!empty($html)) {
        $__tmp = $cacheFile . '.' . getmypid() . '.tmp'; @file_put_contents($__tmp, $html); @rename($__tmp, $cacheFile);
    }
    ob_end_flush();
}
