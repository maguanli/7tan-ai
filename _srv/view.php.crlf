                                                    <div class="avatar-fallback" style="display:none; width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); align-items:center; justify-content:center; color:#fff; font-size:14px; font-weight:bold; flex-shrink:0;">
                                                        <?php echo mb_substr($child['ll_n_name'] ?: $child['ll_name'], 0, 1); ?>
                                                    </div>
                                                </a>
                                                <div class="author-info">
                                                    <a href="/bbs/profile.php?id=<?php echo $childUserId; ?>" class="username-link"><?php echo e($child['ll_n_name'] ?: $child['ll_name']); ?></a>
                                                    <span class="floor sub-floor"><?php echo $floorNum; ?>-<?php echo $childFloor; ?>楼</span>
                                                    <?php if ($currentUser && $currentUserId != $childUserId && !$childIsAiReply): ?>
                                                    <a href="/bbs/message.php?to=<?php echo $childUserId; ?>" class="msg-btn-sm" title="发私信">私信</a>
                                                    <?php endif; ?>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="post-content">
                                            <?php echo safe_output(fast_ubb($child['ll_text'])); ?>
                                            <?php if (!empty($child['ll_furl'])): ?>
                                            <?php 
                                                $childImg = trim($child['ll_furl']);
                                                if (strpos($childImg, 'http') !== 0 && strpos($childImg, '/bbs/') !== 0) {
                                                    $childImg = '/bbs/' . ltrim($childImg, '/');
                                                }
                                            ?>
                                            <div class="reply-images">
