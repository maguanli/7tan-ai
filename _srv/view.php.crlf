                                            <img src="<?php echo e($reply['ll_img'] ?: ''); ?>" alt="" class="avatar" loading="lazy" decoding="async" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div class="avatar-fallback" style="display:none; width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); align-items:center; justify-content:center; color:#fff; font-size:16px; font-weight:bold; flex-shrink:0;">
