                                    <span class="att-icon">📎</span> 附件 (<span id="fileCount"><?php echo count($files); ?></span>)
                                </div>
                                <div class="file-list">
                                    <?php foreach ($files as $file): 
                                        $fileName = basename($file);
                                        $fileExt = strtolower(pathinfo($file, PATHINFO_EXTENSION));
                                        $fileIcon = '📄';
                                        if (in_array($fileExt, ['zip', 'rar', '7z', 'tar', 'gz'])) $fileIcon = '📦';
                                        if (in_array($fileExt, ['apk', 'ipa'])) $fileIcon = '📱';
                                        if (in_array($fileExt, ['pdf'])) $fileIcon = '📕';
                                        if (in_array($fileExt, ['doc', 'docx'])) $fileIcon = '📘';
                                        if (in_array($fileExt, ['xls', 'xlsx'])) $fileIcon = '📗';
