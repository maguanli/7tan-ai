                                    </div>
                                    <?php endif; ?>
                                </div>
                                <div class="post-content">
                                    <?php echo safe_output(fast_ubb($reply['ll_text'])); ?>
                                    <?php if (!empty($reply['ll_furl'])): ?>
                                    <?php 
                                        $replyImg = trim($reply['ll_furl']);
                                        // 确保路径格式正确
                                        if (strpos($replyImg, 'http') === 0) {
                                            // 已经是完整URL，保持不变
                                        } elseif (strpos($replyImg, '/bbs/') === 0) {
                                            // 已经是 /bbs/ 开头，保持不变
                                        } else {
                                            // 其他情况，加上 /bbs/ 前缀
                                            $replyImg = '/bbs/' . ltrim($replyImg, '/');
                                        }
                                    ?>
                                    <div class="reply-images">
                                        <img src="<?php echo e($replyImg); ?>" alt="附件图片" class="reply-image" loading="lazy" decoding="async" onclick="showImage(this.src)">
                                    </div>
                                    <?php endif; ?>
                                </div>
                                <div class="post-footer">
                                    <span class="time"><?php echo $reply['ll_time']; ?></span>
                                    <?php if ($currentUser): ?>
                                    <a href="javascript:void(0);" class="action-btn reply-zan-btn<?php echo $replyZaned ? ' zaned' : ''; ?>" onclick="toggleZan('reply', <?php echo $reply['id']; ?>, this)">
                                        <span class="zan-icon"><?php echo $replyZaned ? '💚' : '🤍'; ?></span>
                                        <span class="zan-count"><?php echo $replyZanCount; ?></span>
                                    </a>
                                    <?php endif; ?>
                                </div>
                            </div>
                            
                            <!-- 子回复容器 - 使用独立wrapper隔离布局 -->
                            <?php 
                            $childCount = !empty($reply['children']) ? count($reply['children']) : 0;
                            $childThreshold = 3; // 超过此数量才折叠
                            if ($childCount > 0): 
                            ?>
                            <div class="sub-replies-wrapper">
                                <?php if ($childCount > $childThreshold): ?>
                                <div class="replies-toggle">
                                    <a href="javascript:void(0);" class="toggle-replies-btn" onclick="toggleReplies(<?php echo $reply['id']; ?>)">
                                        <span class="toggle-icon">▼</span> 查看<?php echo $childCount; ?>条回复
                                    </a>
                                </div>
                                <div class="sub-replies" id="sub-replies-<?php echo $reply['id']; ?>" style="display:none;">
                                <?php else: ?>
                                <div class="sub-replies" id="sub-replies-<?php echo $reply['id']; ?>">
                                <?php endif; ?>
                                    <?php 
                                    $childFloor = 1;
                                    foreach ($reply['children'] as $child): 
                                        $childIsAiReply = !empty($child['ll_ai']);
                                        $childZaned = isset($replyZanedMap[$child['id']]);
                                        $childZanCount = (int)($child['ll_zan'] ?? 0);
                                        $childUserId = $child['ll_useid'] ?? 0;
                                    ?>
                                    <div class="post reply-post sub-reply<?php echo $childIsAiReply ? ' ai-post' : ''; ?>" id="reply-<?php echo $child['id']; ?>">
