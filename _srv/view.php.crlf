// UBB扩展组件库（精美页面标签支持）
require_once __DIR__ . '/ubb_plus.php';

// 预编译正则表达式（避免每次调用重复编译）
$__ubb_patterns__ = null;

/**
 * 获取UBB模式（延迟初始化）
 */
function getUbbPatterns() {
    global $__ubb_patterns__;
    if ($__ubb_patterns__ !== null) {
        return $__ubb_patterns__;
    }
    
    // 全角转半角映射
    $fullwidth_map = [
        '１' => '1', '２' => '2', '３' => '3', '４' => '4', '５' => '5',
        '６' => '6', '７' => '7', '８' => '8', '９' => '9', '０' => '0',
        '－' => '-', '％' => '%',
        '＋' => '+', '＝' => '=', '＊' => '*', '＆' => '&', '～' => '~',
        '（' => '(', '）' => ')', '［' => '[',
        '］' => ']', '｛' => '{', '｝' => '}', '＜' => '<', '＞' => '>',
        '￥' => '¥', '　' => ' ', '’' => "'", '"' => '"'
    ];
    
    // 预编译正则
    $__ubb_patterns__ = [
        'fullwidth' => $fullwidth_map,
        'preg_newline' => '/\\\\\\\\/',
        'preg_img' => '/\[img\](.*?)\[\/img\]/is',
        'preg_img2' => '/（img）(.*?)（\/img）/is',
        'preg_img_en' => '/\(img\)(.*?)\(\/img\)/is',
        'preg_url' => '/\[url=(.*?)\](.*?)\[\/url\]/is',
        'preg_url2' => '/\[url\](.*?)\[\/url\]/is',
        'preg_url_cn' => '/（url=(.*?)）(.*?)（\/url）/is',
        'preg_url_cn2' => '/（url）(.*?)（\/url）/is',
        'preg_url_en' => '/\(url=(.*?)\)(.*?)\(\/url\)/is',
        'preg_url_en2' => '/\(url\)(.*?)\(\/url\)/is',
        'preg_bold' => '/\[b\](.*?)\[\/b\]/is',
        'preg_bold2' => '/（b）(.*?)（\/b）/is',
        'preg_bold_en' => '/\(b\)(.*?)\(\/b\)/is',
        'preg_italic' => '/\[i\](.*?)\[\/i\]/is',
        'preg_italic2' => '/（i）(.*?)（\/i）/is',
        'preg_italic_en' => '/\(i\)(.*?)\(\/i\)/is',
        'preg_underline' => '/\[u\](.*?)\[\/u\]/is',
        'preg_underline2' => '/（u）(.*?)（\/u）/is',
        'preg_underline_en' => '/\(u\)(.*?)\(\/u\)/is',
        'preg_html_open' => '/<(img|a|div|span|p|br|strong|em|u|b|i)\s+[^>]*>/i',
        'preg_html_close' => '/<\/[a-z]+>/i',
        'preg_br' => '/<br\s*\/?>/i',
        'preg_img_error' => '/<img\s+([^>]*?)>/i',
        'preg_s' => '/\(s\)(.+?)\(\/s\)/is',
        'preg_s2' => '/（s）(.*?)（\/s）/is',
        'preg_strike' => '/\(strike\)(.+?)\(\/strike\)/is',
        'preg_strike2' => '/（strike）(.*?)（\/strike）/is',
        'preg_quote' => '/\(quote\)(.+?)\(\/quote\)/is',
        'preg_quote2' => '/（quote）(.*?)（\/quote）/is',
        'preg_big' => '/\(big\)(.+?)\(\/big\)/is',
        'preg_big2' => '/（big）(.*?)（\/big）/is',
        'preg_small' => '/\(small\)(.+?)\(\/small\)/is',
        'preg_small2' => '/（small）(.*?)（\/small）/is',
        'preg_red' => '/\(red\)(.+?)\(\/red\)/is',
        'preg_red2' => '/（red）(.*?)（\/red）/is',
        'preg_green' => '/\(green\)(.+?)\(\/green\)/is',
        'preg_green2' => '/（green）(.*?)（\/green）/is',
        'preg_blue' => '/\(blue\)(.+?)\(\/blue\)/is',
        'preg_blue2' => '/（blue）(.*?)（\/blue）/is',
        'preg_yellow' => '/\(yellow\)(.+?)\(\/yellow\)/is',
        'preg_yellow2' => '/（yellow）(.*?)（\/yellow）/is',
        'preg_marquee' => '/\(marquee\)(.+?)\(\/marquee\)/is',
        'preg_marquee2' => '/（marquee）(.*?)（\/marquee）/is',
        'preg_reply' => '/（reply）(.*?)（\/reply）/is',
        // 新增UBB标签
        'preg_input' => '/\[input=(\d+)\](.*?)\[\/input\]/is',
        'preg_input_cn' => '/（input=(\d+)）(.*?)（\/input）/is',
        'preg_call' => '/\[c\](.*?)\[\/c\]/is',
        'preg_call_cn' => '/（c）(.*?)（\/c）/is',
        'preg_left' => '/\[left\](.*?)\[\/left\]/is',
        'preg_left_cn' => '/（left）(.*?)（\/left）/is',
        'preg_center' => '/\[center\](.*?)\[\/center\]/is',
        'preg_center_cn' => '/（center）(.*?)（\/center）/is',
        'preg_right' => '/\[right\](.*?)\[\/right\]/is',
        'preg_right_cn' => '/（right）(.*?)（\/right）/is',
    ];
    
    return $__ubb_patterns__;
}

/**
 * 获取问候语
 */
function getGreeting() {
    $hour = date('G');
    if ($hour < 6) {
        return '夜深了，早点休息哦~';
    } elseif ($hour < 9) {
        return '早上好！新的一天开始了~';
    } elseif ($hour < 12) {
        return '上午好！';
    } elseif ($hour < 14) {
        return '中午好！';
    } elseif ($hour < 18) {
        return '下午好！';
    } elseif ($hour < 22) {
        return '晚上好！';
    } else {
        return '夜深了，早点休息哦~';
    }
}

/**
 * 快速UBB解析（预编译正则版）
 */
function fast_ubb($text) {
    if (empty($text)) return '';
    
    $patterns = getUbbPatterns();
    
    // 全角转半角
    $text = strtr($text, $patterns['fullwidth']);
    
    // 换行标记：处理双反斜杠 + Windows换行 + Unix换行
    $text = str_replace('\\\\', '<br>', $text);
    $text = str_replace("\r\n", '<br>', $text);
    $text = str_replace("\n", '<br>', $text);
    $text = str_replace("\r", '<br>', $text);
    
    // UBB标签
    $text = preg_replace($patterns['preg_img'], '<a href="$1" target="_blank"><img src="$1" alt="图片" style="max-width:100%;max-height:400px;object-fit:contain;border-radius:8px;" loading="lazy"></a>', $text);
    $text = preg_replace($patterns['preg_img2'], '<a href="$1" target="_blank"><img src="$1" alt="图片" style="max-width:100%;max-height:400px;object-fit:contain;border-radius:8px;" loading="lazy"></a>', $text);
    $text = preg_replace($patterns['preg_img_en'], '<a href="$1" target="_blank"><img src="$1" alt="图片" style="max-width:100%;max-height:400px;object-fit:contain;border-radius:8px;" loading="lazy"></a>', $text);
    $text = preg_replace($patterns['preg_url'], '<a href="$1" target="_blank">$2</a>', $text);
    $text = preg_replace($patterns['preg_url2'], '<a href="$1" target="_blank">$1</a>', $text);
    $text = preg_replace($patterns['preg_url_cn'], '<a href="$1" target="_blank">$2</a>', $text);
    $text = preg_replace($patterns['preg_url_cn2'], '<a href="$1" target="_blank">$1</a>', $text);
    $text = preg_replace($patterns['preg_url_en'], '<a href="$1" target="_blank">$2</a>', $text);
    $text = preg_replace($patterns['preg_url_en2'], '<a href="$1" target="_blank">$1</a>', $text);
    $text = preg_replace($patterns['preg_bold'], '<strong>$1</strong>', $text);
    $text = preg_replace($patterns['preg_bold2'], '<strong>$1</strong>', $text);
    $text = preg_replace($patterns['preg_bold_en'], '<strong>$1</strong>', $text);
    $text = preg_replace($patterns['preg_italic'], '<em>$1</em>', $text);
    $text = preg_replace($patterns['preg_italic2'], '<em>$1</em>', $text);
    $text = preg_replace($patterns['preg_italic_en'], '<em>$1</em>', $text);
    $text = preg_replace($patterns['preg_underline'], '<u>$1</u>', $text);
    $text = preg_replace($patterns['preg_underline2'], '<u>$1</u>', $text);
    $text = preg_replace($patterns['preg_underline_en'], '<u>$1</u>', $text);
    
    // 其他标签
    $text = preg_replace($patterns['preg_s'], '<small>$1</small>', $text);
    $text = preg_replace($patterns['preg_s2'], '<small>$1</small>', $text);
    $text = preg_replace($patterns['preg_strike'], '<del>$1</del>', $text);
    $text = preg_replace($patterns['preg_strike2'], '<del>$1</del>', $text);
    $text = preg_replace($patterns['preg_quote'], '<blockquote style="border-left:3px solid #ccc;padding:5px 10px;margin:10px 0;background:#f9f9f9;">$1</blockquote>', $text);
    $text = preg_replace($patterns['preg_quote2'], '<blockquote style="border-left:3px solid #ccc;padding:5px 10px;margin:10px 0;background:#f9f9f9;">$1</blockquote>', $text);
    $text = preg_replace($patterns['preg_big'], '<big>$1</big>', $text);
    $text = preg_replace($patterns['preg_big2'], '<big>$1</big>', $text);
    $text = preg_replace($patterns['preg_small'], '<small>$1</small>', $text);
    $text = preg_replace($patterns['preg_small2'], '<small>$1</small>', $text);
    $text = preg_replace($patterns['preg_red'], '<span style="color:red;">$1</span>', $text);
    $text = preg_replace($patterns['preg_red2'], '<span style="color:red;">$1</span>', $text);
    $text = preg_replace($patterns['preg_green'], '<span style="color:green;">$1</span>', $text);
    $text = preg_replace($patterns['preg_green2'], '<span style="color:green;">$1</span>', $text);
    $text = preg_replace($patterns['preg_blue'], '<span style="color:blue;">$1</span>', $text);
    $text = preg_replace($patterns['preg_blue2'], '<span style="color:blue;">$1</span>', $text);
    $text = preg_replace($patterns['preg_yellow'], '<span style="color:yellow;">$1</span>', $text);
    $text = preg_replace($patterns['preg_yellow2'], '<span style="color:yellow;">$1</span>', $text);
    $text = preg_replace($patterns['preg_marquee'], '<marquee>$1</marquee>', $text);
    $text = preg_replace($patterns['preg_marquee2'], '<marquee>$1</marquee>', $text);
    $text = preg_replace($patterns['preg_reply'], '<blockquote style="border-left:3px solid #4CAF50;padding:8px 12px;margin:10px 0;background:#f5f5f5;border-radius:4px;">$1</blockquote>', $text);
    
    // 新增UBB标签处理
    // [input=15]内容[/input] - 输入框
    $text = preg_replace($patterns['preg_input'], '<input type="text" size="$1" value="$2" class="ubb-input" readonly onclick="this.select()">', $text);
    $text = preg_replace($patterns['preg_input_cn'], '<input type="text" size="$1" value="$2" class="ubb-input" readonly onclick="this.select()">', $text);
    
    // [c]电话号码[/c] - 直接拨打电话
    $text = preg_replace($patterns['preg_call'], '<a href="tel:$1" class="ubb-tel">📞 $1</a>', $text);
    $text = preg_replace($patterns['preg_call_cn'], '<a href="tel:$1" class="ubb-tel">📞 $1</a>', $text);
    
    // [left]文字[/left] - 居左
    $text = preg_replace($patterns['preg_left'], '<div style="text-align:left;">$1</div>', $text);
    $text = preg_replace($patterns['preg_left_cn'], '<div style="text-align:left;">$1</div>', $text);
    
    // [center]文字[/center] - 居中
    $text = preg_replace($patterns['preg_center'], '<div style="text-align:center;">$1</div>', $text);
    $text = preg_replace($patterns['preg_center_cn'], '<div style="text-align:center;">$1</div>', $text);
    
    // [right]文字[/right] - 居右
    $text = preg_replace($patterns['preg_right'], '<div style="text-align:right;">$1</div>', $text);
    $text = preg_replace($patterns['preg_right_cn'], '<div style="text-align:right;">$1</div>', $text);
    
    // [now] - 当前系统日期时间
    $text = str_replace('[now]', '<span class="ubb-now">' . date('Y年n月j日 H:i:s') . '</span>', $text);
    $text = str_replace('（now）', '<span class="ubb-now">' . date('Y年n月j日 H:i:s') . '</span>', $text);
    
    // [hellos] - 问候语
    $text = str_replace('[hellos]', '<span class="ubb-hello">' . getGreeting() . '</span>', $text);
    $text = str_replace('（hellos）', '<span class="ubb-hello">' . getGreeting() . '</span>', $text);
    
    // [hello] - 欢迎语
    $text = str_replace('[hello]', '<span class="ubb-hello">' . getGreeting() . '</span>', $text);
    $text = str_replace('（hello）', '<span class="ubb-hello">' . getGreeting() . '</span>', $text);
    
    // @提及用户功能
    $text = preg_replace('/@(\w+)/i', '<span style="color:#1890ff;">@$1</span>', $text);
    $text = preg_replace('/@\((.+?)\)/i', '<span style="color:#1890ff;">@$1</span>', $text);
    
    // 表情标签 [表情名称] 格式 - 转换为表情图片
    $emoji_map = [
        '笑' => '/images/20smile-smile.png',
        '大笑' => '/images/21lol.png',
        '俏皮' => '/images/19qiaopi.png',
        '加油' => '/images/08jiayou.png',
        '鼓鼓掌' => '/images/14guzhang.png',
        '牛' => '/images/11niubi.png',
        '怒了' => '/images/24angry.png',
        '哭泣' => '/images/25weep.png',
        '好失望' => '/images/18shiwang.png',
        '滴汗' => '/images/10han.png',
        '为什么' => '/images/13why.png',
        '摊手' => '/images/12hand.png',
        '好逊' => '/images/15xunka.png',
        '很赞' => '/images/03zan.png',
        '围观' => '/images/27weiguan.png',
        '心心' => '/images/36heart.png',
        '心碎了' => '/images/37heartbreak.png',
        '献花花' => '/images/38flower.png',
        '干杯' => '/images/40cheers.png',
        '能力圈' => '/images/33nengliquan.png',
        '毛估估' => '/images/06maogugu.png',
        '护城河' => '/images/28moat.png',
        '赚大了' => '/images/23earn.png',
        '亏大了' => '/images/09lose.png',
        '困顿' => '/images/26sleepy.png',
        '不说了' => '/images/17shutup.png',
        '好困惑' => '/images/43kunhuo.png',
        '想一下' => '/images/44sikao.png',
        '傲' => '/images/45aoman.png',
        '赞成' => '/images/05woshou.png',
        '不赞' => '/images/04bian.png',
    ];
    
    foreach ($emoji_map as $name => $url) {
        $text = str_replace('[' . $name . ']', '<img src="' . $url . '" alt="' . $name . '" title="' . $name . '" style="width:24px;height:24px;vertical-align:middle;"/>', $text);
    }
    
    // 用户链接格式
    $text = preg_replace('/☆(.+?)☆\((ID:\d+)\)/i', '<a href="/bbs/user.php?id=$2" style="color:#52c41a;text-decoration:none;">☆$1☆($2)</a>', $text);
    $text = preg_replace('/(.+?)☆\((ID:\d+)\)/i', '<a href="/bbs/user.php?id=$2" style="color:#52c41a;text-decoration:none;">$1☆($2)</a>', $text);
    $text = preg_replace('/^☆(.+?)☆\((ID:\d+)\)/i', '<a href="/bbs/user.php?id=$2" style="color:#52c41a;text-decoration:none;">☆$1☆($2)</a>', $text);
    
    // 给img标签添加onerror处理
    $text = preg_replace_callback('/<img\s+([^>]*?)>/i', function($matches) {
        if (preg_match('/\bonerror\s*=/i', $matches[1])) {
            return $matches[0];
        }
        return '<img ' . $matches[1] . ' onerror="this.onerror=null;this.src=\'/images/blank.png\';this.alt=\'图片已丢失\';">';
    }, $text);
    
    // 给没有协议的链接自动加上 https:// (防止外链被当成相对路径)
    $text = preg_replace('/<a\s+href="(?!https?:\/\/|\/\/|mailto:|tel:|#|\/|javascript:)([^"]+)"/i', '<a href="https://$1"', $text);
    
    // 重写旧7723论坛帖子链接到新URL (view.aspx?id=XXX → /bbs/XXX/)
    $text = preg_replace(
        '/<a\s+href="https?:\/\/(?:bbs\.7723\.com\/lts\/view\.aspx?|wap\.7723\.cn\/lts\/view\.asp)\?(?:[^"&]*&)*id=(\d+)[^"]*"/i',
        '<a href="/bbs/$1/"',
        $text
    );
    
    // 重写旧7723版块链接到新论坛首页 (index.aspx?idd=XXX → /bbs/)
    $text = preg_replace(
        '/<a\s+href="https?:\/\/bbs\.7723\.com\/lts\/index\.aspx?\?[^"]*"/i',
        '<a href="/bbs/"',
        $text
    );
    
    // 重写旧7723会员链接到新论坛首页 (/hy/* 无法映射到新系统用户)
    $text = preg_replace(
        '/<a\s+href="https?:\/\/(?:bbs\.7723\.com|wap\.7723\.cn)\/hy\/[^"]*"/i',
        '<a href="/bbs/"',
        $text
    );
    
    // UBB+ 扩展标签（精美页面组件）
    $text = ubb_plus($text);

    return $text;
}

// 引入配置获取数据库函数
require_once __DIR__ . '/config.php';
require_once __DIR__ . '/ai_helper.php';

$pdo = getDB();

// 获取帖子ID
$topicId = isset($_GET['id']) ? intval($_GET['id']) : 0;
$action = $_GET['action'] ?? '';
$sortOrder = isset($_GET['sort']) && $_GET['sort'] === 'desc' ? 'DESC' : 'ASC';

if ($topicId <= 0) {
    header('Location: /bbs/');
    exit;
}

// 兼容旧 GET 收藏链接：不再通过 GET 改状态，统一 301 到规范短链详情页
if ($action === 'favorite') {
    header('HTTP/1.1 301 Moved Permanently');
    header('Location: ' . bbsUrl('topic', $topicId));
    exit;
}

// 检查用户是否已登录
$currentUserId = getCurrentUserId();
$currentUser = isLoggedIn() ? getUserInfo($currentUserId) : null;

// 处理收藏/取消收藏（仅 POST + CSRF）
if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['action'] ?? '') === 'favorite') {
    if ($currentUserId <= 0) {
        header('Location: /bbs/login.php?redirect=' . urlencode(bbsUrl('topic', $topicId)));
        exit;
    }
    bbs_verify_csrf();

    $stmt = $pdo->prepare("SELECT id FROM ll_shouchang WHERE ll_useid = ? AND ll_id = ?");
    $stmt->execute([$currentUserId, $topicId]);
    $existing = $stmt->fetch();
    
    if ($existing) {
        $pdo->prepare("DELETE FROM ll_shouchang WHERE id = ?")->execute([$existing['id']]);
    } else {
        // [GSC-FIX 2026-10-03] ll_lt 无 ll_logo 列，原语句抛 SQLSTATE[42S22] 1054，收藏功能必报错
        $stmt = $pdo->prepare("SELECT ll_biaoti FROM ll_lt WHERE id = ? AND (ll_or IS NULL OR ll_or = 0 OR ll_or = 1)");
        $stmt->execute([$topicId]);
        $topicInfo = $stmt->fetch();
        if ($topicInfo) {
            $stmt = $pdo->prepare("INSERT INTO ll_shouchang (ll_useid, ll_id, ll_idd, ll_biaoti, ll_logo, ll_retime) VALUES (?, ?, 0, ?, ?, NOW())");
            $stmt->execute([$currentUserId, $topicId, $topicInfo['ll_biaoti'], $topicInfo['ll_logo'] ?? '']);
        }
    }
    header('HTTP/1.1 303 See Other');
    header('Location: ' . bbsUrl('topic', $topicId));
    exit;
}

// ==================== 页面缓存优化（仅未登录用户） ====================
$cacheDir = __DIR__ . '/../cache/topic/';
if (!is_dir($cacheDir)) {
    @mkdir($cacheDir, 0755, true);
}
$cacheKey = $topicId . '_' . $sortOrder . '_zh.cache';
$cacheFile = $cacheDir . $cacheKey;
$cacheTime = 180; // 缓存3分钟
$useCache = false;

// 未登录用户优先读取缓存
if ($currentUserId <= 0 && file_exists($cacheFile) && (time() - filemtime($cacheFile) < $cacheTime)) {
    $useCache = true;
}

if ($useCache) {
    // 浏览量计数：缓存命中路径原来是直接 exit 的，导致浏览量被严重少计。
    // 只统计真人——本站爬虫流量远大于真人（8 天生成 78 万缓存文件），一律计数会严重虚高。
    if (!isBotRequest()) {
        $pdo->prepare("UPDATE ll_lt SET ll_rc = COALESCE(ll_rc, 0) + 1 WHERE id = ?")->execute([$topicId]);
    }
    // 快速路径：直接返回缓存页面
    readfile($cacheFile);
    exit;
}
// ==================== 缓存逻辑结束 ====================

// 完整加载帖子数据（优化：不使用事务，直接更新浏览量）
$pdo->prepare("UPDATE ll_lt SET ll_rc = COALESCE(ll_rc, 0) + 1 WHERE id = ?")->execute([$topicId]);

$stmt = $pdo->prepare("
    SELECT t.*, c.ll_title as bankuai_name, u.ll_n_name as author_nick, u.ll_img as author_avatar, u.ll_name as author_name
    FROM ll_lt t
    LEFT JOIN ll_class c ON t.ll_idd = c.id
    LEFT JOIN ll_useregs u ON t.ll_useid = u.id
    WHERE t.id = ? AND (t.ll_or IS NULL OR t.ll_or = 0 OR t.ll_or = 1)
");
$stmt->execute([$topicId]);
$topic = $stmt->fetch();

if (!$topic) {
    http_response_code(404);
    require __DIR__ . '/../404.php';
    exit;
}

// 现金任务关联（板块3=现金任务）
$cashTask = null;
$cashTaskApplied = false;
if ((int)$topic['ll_idd'] === 3 && $currentUserId > 0) {
    $ctStmt = $pdo->prepare("SELECT * FROM ll_cash_tasks WHERE bbs_post_id = ?");
    $ctStmt->execute([$topicId]);
    $cashTask = $ctStmt->fetch();
    if ($cashTask) {
        // 检查当前用户是否已申请
        $appStmt = $pdo->prepare("SELECT id FROM ll_cash_task_applications WHERE task_id = ? AND user_id = ?");
        $appStmt->execute([$cashTask['id'], $currentUserId]);
        $cashTaskApplied = $appStmt->fetch() !== false;
    }
}
// 未登录用户也要查询任务信息（用于显示状态）
if ($cashTask === null && (int)$topic['ll_idd'] === 3) {
    $ctStmt = $pdo->prepare("SELECT * FROM ll_cash_tasks WHERE bbs_post_id = ?");
    $ctStmt->execute([$topicId]);
    $cashTask = $ctStmt->fetch();
}

// 检查当前用户是否有编辑权限（楼主或版主）- 优化：合并查询
$canEditTopic = false;
$isAuthor = false; // 初始化，避免未定义变量
$isTopicAuthor = false; // 初始化，避免未定义变量
if ($currentUserId > 0) {
    // 楼主可以编辑自己的帖子
    $isAuthor = ($currentUserId == $topic['ll_useid']);
    
    // 版主可以管理该板块的帖子（版主对自己帖子也有版主权限）
    $isModerator = false;
    $stmt = $pdo->prepare("SELECT id FROM ll_ltbz WHERE ll_useid = ? AND ll_idd = ? LIMIT 1");
    $stmt->execute([$currentUserId, $topic['ll_idd']]);
    if ($stmt->fetch()) {
        $isModerator = true;
    }
    
    $canEditTopic = $isAuthor || $isModerator;
    $isTopicAuthor = $isAuthor; // 楼主标识，用于置顶回复
}

// 回复列表 - 只查询一级回复（父回复）
$page = 1;
$pageSize = 20;
$offset = ($page - 1) * $pageSize;

// 只统计一级回复数量
$stmt = $pdo->prepare("SELECT COUNT(*) FROM ll_lthf WHERE ll_id = ? AND (ll_father_id = 0 OR ll_father_id IS NULL)");
$stmt->execute([$topicId]);
$totalReplies = $stmt->fetchColumn();
$totalPages = max(1, ceil($totalReplies / $pageSize));

// 查询一级回复（PDO不支持 LIMIT/OFFSET 参数绑定，需直接拼接）
// 置顶回复优先显示 - 兼容两种置顶方式: ll_ding=1 或 ll_time2='2100-10-10 12:12:12'
$stmt = $pdo->prepare("
    SELECT h.*, u.ll_n_name, u.ll_img, u.ll_dj,
           (CASE WHEN h.ll_ding = 1 OR h.ll_time2 = '2100-10-10 12:12:12' THEN 1 ELSE 0 END) as is_pinned
    FROM ll_lthf h
    LEFT JOIN ll_useregs u ON h.ll_useid = u.id
    WHERE h.ll_id = ? AND (h.ll_father_id = 0 OR h.ll_father_id IS NULL)
    ORDER BY is_pinned DESC, h.id {$sortOrder}
    LIMIT {$pageSize} OFFSET {$offset}
");
$stmt->execute([$topicId]);
$replies = $stmt->fetchAll();

// 优化：一次性查询所有子回复（替代 N+1 查询）
$parentIds = array_column($replies, 'id');
$childrenMap = [];
if (!empty($parentIds)) {
    $placeholders = implode(',', array_fill(0, count($parentIds), '?'));
    $stmt = $pdo->prepare("
        SELECT h.*, u.ll_n_name, u.ll_img, u.ll_dj
        FROM ll_lthf h
        LEFT JOIN ll_useregs u ON h.ll_useid = u.id
        WHERE h.ll_father_id IN ({$placeholders})
        ORDER BY h.id ASC
    ");
    $stmt->execute($parentIds);
    $allChildren = $stmt->fetchAll();
    
    // 按父ID分组
    foreach ($allChildren as $child) {
        $childrenMap[$child['ll_father_id']][] = $child;
    }
}

// 附加子回复到每个父回复
foreach ($replies as &$reply) {
    $reply['children'] = $childrenMap[$reply['id']] ?? [];
}
unset($reply);

// 收藏和点赞状态
$isFavorited = false;
$topicZaned = false;
$replyZanedMap = [];
$topicZanCount = (int)($topic['ll_zan'] ?? 0);

if ($currentUserId > 0) {
    // 收集所有回复ID（包括子回复）
    $replyIds = array_column($replies, 'id');
    foreach ($replies as $reply) {
        if (!empty($reply['children'])) {
            $childIds = array_column($reply['children'], 'id');
            $replyIds = array_merge($replyIds, $childIds);
        }
    }
    $allTargetIds = array_merge([$topicId], $replyIds);
    
    if (!empty($allTargetIds)) {
        $placeholders = implode(',', array_fill(0, count($allTargetIds), '?'));
        $stmt = $pdo->prepare("
            SELECT ll_type, ll_targetid FROM ll_zan 
            WHERE ll_useid = ? AND ll_targetid IN ({$placeholders})
        ");
        $stmt->execute(array_merge([$currentUserId], $allTargetIds));
        $zanRows = $stmt->fetchAll();
        
        foreach ($zanRows as $row) {
            if ($row['ll_type'] === 'topic' && $row['ll_targetid'] == $topicId) {
                $topicZaned = true;
            } elseif ($row['ll_type'] === 'reply') {
                $replyZanedMap[$row['ll_targetid']] = true;
            }
        }
    }
    
    $stmt = $pdo->prepare("SELECT id FROM ll_shouchang WHERE ll_useid = ? AND ll_id = ?");
    $stmt->execute([$currentUserId, $topicId]);
    $isFavorited = $stmt->fetch() !== false;
}

// 开启输出缓冲用于缓存
if ($currentUserId <= 0) {
    ob_start();
}
?>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <base href="/bbs/">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?php echo e(toHalfWidth($topic['ll_biaoti'])); ?> - 7坛游戏社区</title>
    <link rel="canonical" href="<?= htmlspecialchars(SITE_URL . '/bbs/' . $topic['id'] . '/', ENT_QUOTES) ?>">
    <?php
    // SEO meta
    $topicTitle = toHalfWidth($topic['ll_biaoti']);
    $__descRaw = trim(strip_tags(preg_replace('/\[(?:img|url|b|i|u|s|quote|color|size|center|left|right|red|green|blue|yellow|big|small|marquee|strike|input|c)[^\]]*\].*\[\/(?:img|url|b|i|u|s|quote|color|size|center|left|right|red|green|blue|yellow|big|small|marquee|strike|input|c)\]/isU', '', $topic['ll_text'] ?? '')));
    $__descRaw = preg_replace('/\((?:img|url)\)(.*?)\(\/(?:img|url)\)/is', '', $__descRaw);
    // UBB+ 新标签：移除标签本体、保留文字（摘要/分享卡片更干净）
    $__descRaw = preg_replace('/\[\/?(?:hl|title|subtitle|caption|note|warn|tip|card|badge|btn|fold|table|tr|td|th|code|divider|hr)[^\]]*\]/i', ' ', $__descRaw);
    $__descRaw = preg_replace('/\[[^\]]{0,60}\]/s', ' ', $__descRaw); // 兜底：清除残余方括号标记
    $__descRaw = trim(preg_replace('/\s+/u', ' ', $__descRaw));
    $topicDesc = mb_substr($__descRaw, 0, 160, 'UTF-8');
    // [GSC-FIX 2026-10-03] DiscussionForumPosting 必须含 text/image/video 至少一项。
    // 原 image 分支读 $topic['ll_logo']，但 ll_lt 表无此列（该列在 ll_class 上）→ 恒为空；
    // 且从未输出 text → Search Console 报「应指定 text、image 或 video」。
    $topicText = mb_substr($__descRaw, 0, 2000, 'UTF-8');
    $topicImage = '';
    // 图片：正文 [img]…[/img] 或 [img=宽]…[/img]（本站新图均为 https://img.7tan.com/uploads/...）
    // 注：老附件 ll_url 指向的 pic/*.gif 已 404，故不采用，避免输出不可达图片 URL。
    if (preg_match('/\[img[^\]]*\]([^\[]+?)\[\/img\]/i', (string)($topic['ll_text'] ?? ''), $__im)) {
        $__u = trim($__im[1]);
        if (preg_match('~^https?://~i', $__u)) {
            $topicImage = $__u;
        } elseif ($__u !== '') {
            $topicImage = 'https://img.7tan.com/' . ltrim($__u, '/');
        }
    }
    // 兜底：正文为空时用标题，确保 text/image/video 至少一项非空
    if ($topicText === '') { $topicText = $topicTitle; }
    $topicUrl = SITE_URL . bbsUrl('topic', $topicId);
    // 2.1（2026-10-30）：帖子无正文配图时用站内默认分享图，否则微信/QQ 卡片出灰块
    // 2.1b（2026-10-30）：正文里的图绝大多数是编辑器粘进来的原生 <img> HTML，
    // 不是 [img] UBB。上面那条正则永远命不中，导致 og:image 全站落到 logo 兜底。
    // 这里补一条 HTML <img src> 兜底，只在 UBB 没取到时生效。
    if ($topicImage === '' && preg_match('/<img\b[^>]*\bsrc\s*=\s*["\']([^"\']+)["\']/i', (string)($topic['ll_text'] ?? ''), $__im2)) {
        $__u2 = trim(html_entity_decode($__im2[1], ENT_QUOTES, 'UTF-8'));
        if (preg_match('~^https?://~i', $__u2)) {
            $topicImage = $__u2;
        } elseif ($__u2 !== '' && stripos($__u2, 'data:') !== 0) {
            $topicImage = 'https://img.7tan.com/' . ltrim($__u2, '/');
        }
    }
    $__shareImage = ($topicImage !== '') ? $topicImage : 'https://www.7tan.com/images/og-1200x630.png';
    $topicDate = explode(' ', $topic['ll_time1'])[0];
    $bankuaiName = toHalfWidth($topic['bankuai_name'] ?? '');
    ?>
    <meta name="description" content="<?php echo htmlspecialchars($topicDesc, ENT_QUOTES); ?>">
    <meta name="keywords" content="<?php echo htmlspecialchars($topicTitle . ',' . $bankuaiName . ',' . '游戏论坛,7坛社区', ENT_QUOTES); ?>">
