# ============================================
# 七坛 QQ 机器人 配置模板
# 复制此文件为 .env 并修改
# ============================================

HOST=127.0.0.1
PORT=8080
DEBUG=true
COMMAND_START=["/", "！", "／"]

# 机器人QQ号
BOT_QQ=你的机器人QQ号

# 超级用户QQ号（管理员）
SUPERUSERS=["你的QQ号"]

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 机器人昵称
NICKNAME=["七坛", "小七", "77"]
