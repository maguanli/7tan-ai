# ORG?BODYSTATES 躯体稳态器官

bodystate_buffer = {

    "fatigue":0.0,        # 疲劳度 0?1

    "resource_pressure":0.0, # 资源/算力压力

    "damage_level":0.0,   # 损伤告警等级

    "internal_signal_queue":[] # 输出信号送往ORG?B动机器官

}

def organ_bodystates_tick(ctx=None):

    """躯体稳态每周期更新，生成内部压力信号推送给ORG?B"""

    try:

        traces = getattr(ctx, "traces", None) if ctx is not None else None

        n = len(traces) if traces else 0

        bodystate_buffer["resource_pressure"] = min(1.0, round(n / 5000.0, 4))

        fatigue = float(bodystate_buffer.get("fatigue", 0.0))

        bodystate_buffer["fatigue"] = min(1.0, round(fatigue + 0.001, 4))

        sig = f"resource_pressure={bodystate_buffer['resource_pressure']:.2f}"

        if sig not in bodystate_buffer["internal_signal_queue"]:

            bodystate_buffer["internal_signal_queue"].append(sig)

        if len(bodystate_buffer["internal_signal_queue"]) > 10:

            bodystate_buffer["internal_signal_queue"].pop(0)

    except Exception:

        pass




# ORG?VALENCE 情绪效价标签器官

valence_cache:Dict[str,float] = {} # item_id → valence [-1.0厌恶 … 0中性 … +1.0愉悦]

def organ_valence_tick(ctx=None):

    """给记忆、思考片段打上情绪效价标签，影响注意力权重"""

    try:

        traces = getattr(ctx, "traces", None) if ctx is not None else None

        if not traces:

            return

        for t in traces[-10:]:

            if not isinstance(t, dict):

                continue

            key = f"{t.get('scene')}:{t.get('action')}"

            valence_cache[key] = 0.5 if t.get("action_finished") else -0.5

    except Exception:

        pass




# ORG?INHIBIT 冲动抑制调控器官

inhibit_rule_list:List[Dict[str,Any]] = []

def organ_inhibit_tick(ctx=None):

    """扫描ORG?E的active_goals，过滤压制不合理目标"""

    try:

        goals = working_memory.get("active_goals") or []

        if isinstance(goals, list):

            cleaned = []

            seen = set()

            for g in goals:

                s = str(g).strip()

                if s and s not in seen and len(s) <= 100:

                    seen.add(s)

                    cleaned.append(g)

            working_memory["active_goals"] = cleaned[-20:]

    except Exception:

        pass




# ORG?CONSOLIDATE 记忆重放巩固器官

replay_buffer:List[Any] = []

def organ_consolidate_tick(ctx=None):

    """后台记忆重放；把碎片整理降噪后写入ORG?A；清理过期草稿"""

    global replay_buffer

    try:

        if not replay_buffer:

            return

        if ctx is not None and hasattr(ctx, "add_trace"):

            for frag in list(replay_buffer):

                if isinstance(frag, dict) and frag.get("scene") and frag.get("action"):

                    ctx.add_trace(

                        frag.get("scene"), frag.get("action"),

                        finished=bool(frag.get("action_finished", True)),

                        changed=bool(frag.get("scene_changed", False)),

                        reduced=bool(frag.get("defect_reduced", False)),

                        gained=bool(frag.get("knowledge_gained", False)),

                    )

        replay_buffer.clear()

    except Exception:

        pass




