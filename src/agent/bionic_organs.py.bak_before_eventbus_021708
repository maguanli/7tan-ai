def get_organ(code: str) -> Optional[BionicOrgan]:

    return organ_registry.get(code)



def organ_tick_all(ctx=None):

    """系统主循环，驱动所有已开启器官执行tick。

    ctx 可选：传 world_model 的 memory 实例，使器官 tick 作用于真实状态而非内部空缓冲。"""

    for code, org in organ_registry.items():

        if not (org.enabled and org.tick_func is not None):

            continue

        try:

            if ctx is None:

                org.tick_func()

            else:

                try:

                    org.tick_func(ctx)

                except TypeError:

                    org.tick_func()

        except Exception:

            continue



# ====================== ORG?A 海马体?长期记忆器官 ModuleA ======================

memory_library: List[Dict[str, Any]] = []



def module_a_tick(ctx=None):

    """记忆生命周期：权重衰减、冷热记忆自动维护。

    ctx 可选：world_model 的 memory 实例；传入时对其 traces 做衰减，

    否则对内部 memory_library 做衰减。"""

    target = None

    if ctx is not None:

        target = getattr(ctx, "traces", None)

    if target is None:

        target = memory_library

    for mem in target:

        if isinstance(mem, dict):

            # 权重衰减逻辑

            mem["weight_eff"] = max(0.0, float(mem.get("weight_eff", 1.0)) - 0.001)







def module_a_bump(memory, scene, action=None, strength=0.05):

    """记忆命中增强：轨迹被检索/推演命中时增重（变热），与 module_a_tick 的衰减构成冷热闭环。

    命中→增重（热），不命中→每轮衰减（冷）。weight_eff 上限 2.0 防止无限增重。"""

    if memory is None:

        return

    try:

        traces = getattr(memory, "traces", None)

        if not traces:

            return

        cap = 2.0

        for t in traces:

            if not isinstance(t, dict):

                continue

            if str(t.get("scene")) != str(scene):

                continue

            if action is not None and str(t.get("action")) != str(action):

                continue

            t["weight_eff"] = min(cap, float(t.get("weight_eff", 1.0)) + strength)

    except Exception:

        pass

